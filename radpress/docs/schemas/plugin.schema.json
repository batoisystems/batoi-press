{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Batoi Press plugin",
    "type": "object",
    "required": [
        "schema",
        "id",
        "name",
        "version",
        "api",
        "kind",
        "compatibility",
        "files",
        "trust"
    ],
    "properties": {
        "schema": {
            "const": 1
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "api": {
            "const": "1.0.0"
        },
        "kind": {
            "enum": [
                "native",
                "declarative"
            ]
        },
        "files": {
            "type": "object",
            "maxProperties": 200,
            "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
            }
        },
        "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "content.read",
                    "content.propose",
                    "media.read",
                    "audit.write",
                    "blocks.render",
                    "admin.routes",
                    "forms.email",
                    "forms.webhook",
                    "events.listen",
                    "state.write"
                ]
            }
        },
        "trust": {
            "type": "object",
            "required": [
                "key_id",
                "signature"
            ],
            "properties": {
                "key_id": {
                    "type": "string"
                },
                "signature": {
                    "type": "string"
                }
            }
        }
    }
}
