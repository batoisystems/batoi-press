{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Batoi Press order",
    "type": "object",
    "required": [
        "schema",
        "id",
        "mode",
        "items",
        "currency",
        "total_minor",
        "customer",
        "allocation",
        "payment_status",
        "fulfilment_status"
    ],
    "properties": {
        "schema": {
            "const": 1
        },
        "id": {
            "type": "string",
            "pattern": "^ord_[a-f0-9]{32}$"
        },
        "mode": {
            "enum": [
                "test",
                "live"
            ]
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20
        },
        "currency": {
            "enum": [
                "AED",
                "AUD",
                "BHD",
                "CAD",
                "CHF",
                "EUR",
                "GBP",
                "HKD",
                "INR",
                "JPY",
                "KRW",
                "KWD",
                "NZD",
                "OMR",
                "SGD",
                "USD"
            ]
        },
        "total_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999
        },
        "customer": {
            "type": "string",
            "pattern": "^v[12]\\."
        },
        "allocation": {
            "enum": [
                "held",
                "sold",
                "released",
                "unavailable"
            ]
        },
        "payment_status": {
            "enum": [
                "pending",
                "expired",
                "paid",
                "partially_refunded",
                "refunded"
            ]
        },
        "fulfilment_status": {
            "enum": [
                "unfulfilled",
                "fulfilled",
                "needs_attention"
            ]
        }
    }
}
