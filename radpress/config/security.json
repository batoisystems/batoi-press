{
  "html_allowlist": "default",
  "session_name": "batoi_press_session",
  "installer_lock": "radpress/config/installed.lock",
  "session": {
    "idle_seconds": 1800,
    "absolute_seconds": 43200
  },
  "headers": {
    "csp_mode": "report-only",
    "hsts": true,
    "hsts_max_age": 31536000,
    "referrer_policy": "strict-origin-when-cross-origin",
    "permissions_policy": "camera=(), microphone=(), geolocation=(), payment=()"
  },
  "machine_allowed_origins": [],
  "oauth": {
    "enabled": false,
    "issuer": "",
    "resource": "",
    "authorization_servers": [],
    "jwks_uri": "",
    "allowed_jwks_hosts": [],
    "scopes_supported": ["site:read", "content:read"]
  },
  "uploads": {
    "max_bytes": 26214400,
    "library_max_bytes": 26214400,
    "allowed_extensions": ["jpg", "jpeg", "png", "gif", "webp", "pdf", "txt", "md", "css", "js", "mjs", "mp3", "wav", "ogg", "m4a", "mp4", "webm", "mov"]
  }
}
